{
  "$schema": "https://raw.githubusercontent.com/lunarmoon26/agent-skill-runtime/main/skill-runtime.schema.json",
  "manifestVersion": 1,
  "name": "photo-processing",
  "tools": [
    {
      "title": "Package Image Assets",
      "name": "photo_process",
      "description": "Batch resize and export assets (including multi-size ICO), derive luminance alpha, or split sprite grids with CSS/JSON metadata. Use PhotoCraft for inspection and general editing. Pass CLI arguments as separate tokens; no shell is invoked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": ["resize", "key-luminance", "sprite-grid"],
            "description": "Photo operation to run"
          },
          "arguments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Arguments after the command, with each path, flag, and value as a separate item"
          }
        },
        "required": ["command", "arguments"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "command": { "type": "string" },
          "messages": { "type": "array", "items": { "type": "string" } },
          "records": { "type": "array", "items": {} }
        },
        "required": ["ok", "command", "messages", "records"],
        "additionalProperties": false
      },
      "entrypoint": {
        "engine": "python-uv",
        "path": "scripts/tool.py"
      },
      "capabilities": ["filesystem-read", "filesystem-write"],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "limits": {
        "timeoutMs": 600000,
        "maxInputBytes": 1048576,
        "maxOutputBytes": 4194304
      }
    },
    {
      "title": "Edit Layered Images with PhotoCraft",
      "name": "photocraft",
      "description": "Inspect layered documents, discover engine commands, edit PSD/PSB/native documents, convert, or batch actions with separately installed photocraft-cli on PATH. CLI arguments are separate tokens; no shell is invoked. Can overwrite files; commands/actions may write beyond --out. Review trusted commands and authorized paths first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["info", "commands", "convert", "run", "batch"] },
          "arguments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Native CLI tokens following the subcommand; keep each JSON params value in one string"
          }
        },
        "required": ["command", "arguments"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "command": { "type": "string" },
          "messages": { "type": "array", "items": { "type": "string" } },
          "records": { "type": "array", "items": {} },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["ok", "command", "messages", "records", "warnings"],
        "additionalProperties": false
      },
      "entrypoint": { "engine": "python-uv", "path": "scripts/photocraft_tool.py" },
      "capabilities": ["filesystem-read", "filesystem-write", "process"],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "limits": { "timeoutMs": 600000, "maxInputBytes": 1048576, "maxOutputBytes": 4194304 }
    }
  ]
}
