{
  "version": 1,
  "rules": [
    {
      "id": "private-home-prefix",
      "category": "private_identity",
      "literal": "/home/EXAMPLE_PRIVATE_USER/",
      "action": "replace",
      "replacement": "/path/to/"
    },
    {
      "id": "private-name",
      "category": "private_identity",
      "literal": "EXAMPLE PRIVATE NAME",
      "action": "review"
    },
    {
      "id": "private-domain",
      "category": "private_identity",
      "literal": "internal.example.invalid",
      "action": "review"
    }
  ]
}
